# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgres://signage:signage_pass@localhost:5432/digital_signage

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Admin inicial (usado por `npm run seed`)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Archivos subidos
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# CORS (origenes permitidos del panel web, separados por coma). "*" para permitir todos en LAN.
CORS_ORIGIN=*
